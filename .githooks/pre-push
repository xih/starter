#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "Refusing to push directly to ${remote_ref#refs/heads/}."
      exit 1
      ;;
  esac
done

if [ "${RUN_PRE_PUSH_VERIFY:-0}" = "1" ]; then
  make verify
else
  echo "Skipping exhaustive pre-push verification. Run RUN_PRE_PUSH_VERIFY=1 git push to include make verify."
fi
